{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cliniqo",
  "version": "1.0.0",
  "identifier": "com.cliniqo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cliniqo — Clinic Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset:; font-src 'self' data:; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000 https://cliniqo-backend-68x3.onrender.com https://api.cliniqo.app ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "installMode": "currentUser"
      }
    }
  }
}
