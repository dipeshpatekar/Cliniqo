# Cliniqo Backend Environment Configuration Template
# Copy this file to .env and configure local development variables.
# NEVER commit .env, live credentials, or production connection strings.

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8443

# MongoDB Atlas connection URI (replace placeholders with cluster credentials)
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net

# MongoDB database name
MONGODB_DB_NAME=cliniqo_dev

# Authentication & Session Security (Phase 3A+)
# JWT secrets must be at least 32 characters in production. Do NOT use default or weak secrets.
JWT_ACCESS_SECRET=<at-least-32-char-random-jwt-access-secret>
JWT_REFRESH_SECRET=<at-least-32-char-distinct-random-jwt-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2id Hashing Parameters (optional, defaults to RFC 9106 recommended values)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
